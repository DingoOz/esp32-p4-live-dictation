CONFIG_IDF_TARGET="esp32p4"
# Waveshare ESP32-P4-WIFI6-POE-ETH: chip rev v1.3 (360 MHz, PSRAM up to 200 MHz), 32 MB flash
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
# from esp32-pie-asr's firmware: the cache its kernels were tuned for, a 32 KB main task for the encoder's chunks,
# no task watchdog (a chunk keeps both cores busy)
CONFIG_CACHE_L2_CACHE_256KB=y
CONFIG_CACHE_L2_CACHE_LINE_128B=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=32768
CONFIG_ESP_TASK_WDT_EN=n
CONFIG_FATFS_LFN_HEAP=y
